# ==============================================================================
# GearSpot Web Frontend (Vite)
# HUOM: ÄLÄ KOSKAAN TALLENNA SALAISUUKSIA TÄHÄN TIEDOSTOON TAI GITTIIN!
# Kaikki salaiset API-avaimet ja tietokantayhteydet asetetaan yksinomaan .env.local -tiedostoon.
# ==============================================================================
VITE_APP_NAME="GearSpot"
VITE_APP_CITY="Oulu"

# Backend REST API / Serverless Database Endpoint
VITE_API_URL="http://localhost:8000/api"
VITE_API_KEY="your_optional_api_key_in_env_local"

# ==============================================================================
# Google Service Account (Google Sheets & Google Drive API)
# ==============================================================================
SERVICE_ACCOUNT_FILE="credentials/service-account.json"

# ==============================================================================
# YouTube Data API v3
# ==============================================================================
YOUTUBE_API_KEY="AIzaSyYourYouTubeApiKeyHere"

# ==============================================================================
# Google Sheets
# ==============================================================================
SHEET_ID="your_google_sheet_id_here"
